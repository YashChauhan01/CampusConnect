# Copy to .env (never commit it) and adjust. Used by `docker compose up`.

# --- Required for any real deployment ---
# At least 32 characters. Generate: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-characters
DB_PASSWORD=change-me
# Comma separated college email domains allowed to register.
APPROVED_DOMAINS=college.edu

# --- Optional ---
# smtp (default) sends through SMTP_*; log prints emails to the backend log (development only).
MAIL_MODE=smtp
MAIL_FROM=noreply@campusconnect.local
# Set true when served over HTTPS so the refresh cookie is marked Secure.
SECURE_COOKIES=false
# Comma separated emails that get the administrator role (zone management) when they log in.
ADMIN_EMAILS=

# Optional AI skill verification (off by default). Any OpenAI-compatible /chat/completions endpoint works:
# a hosted provider, or a local Ollama (AI_BASE_URL=http://host.docker.internal:11434/v1, AI_MODEL=llama3.1).
AI_ENABLED=false
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=

# Public URL of the web app (used for CORS and links inside emails).
FRONTEND_URL=http://localhost:5173
